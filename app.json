{
  "expo": {
    "name": "Vitirify",
    "slug": "kabin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F4F0",
    "primaryColor": "#FE382B",
    "scheme": "kabin",
    "ios": {
      "bundleIdentifier": "app.kabin.mobile",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.kabin.app",
      "softwareKeyboardLayoutMode": "pan",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FE382B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F4F0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kıyafet ekleme ve sanal deneme için galerindeki fotoğraflara erişmemiz gerekiyor.",
          "cameraPermission": "Dolabına kıyafet eklemek için kameraya erişmemiz gerekiyor."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FE382B"
        }
      ],
      "expo-router",
      "expo-image",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "8ba7778a-ee4d-43b0-9594-74b6624a7af6"
      }
    },
    "owner": "harunbadurs-team"
  }
}
